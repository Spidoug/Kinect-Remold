[Unit]
Description=Kinect 360 Remold NUI compatibility and skeleton relay
PartOf=kinect360-remold.target
After=kinect360-remold-camera.service kinect360-remold-audio.service
Wants=kinect360-remold-camera.service kinect360-remold-audio.service

[Service]
Type=simple
ExecStart=/usr/libexec/kinect360-remold/kinect360-remold-nui
Restart=on-failure
RestartSec=1

[Install]
WantedBy=kinect360-remold.target
