[Unit]
StartLimitIntervalSec=30
StartLimitBurst=5
Description=Kinect Xbox 360 Remold V4L2 virtual camera
PartOf=kinect360-remold.target
After=kinect360-remold-camera.service
Requires=kinect360-remold-camera.service

[Service]
Type=simple
ExecStart=/usr/libexec/kinect360-remold/kinect360-remold-v4l2
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0022

[Install]
WantedBy=kinect360-remold.target
