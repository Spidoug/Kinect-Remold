[Unit]
StartLimitIntervalSec=30
StartLimitBurst=5
Description=Kinect Xbox 360 Remold motor/control broker
PartOf=kinect360-remold.target
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/libexec/kinect360-remold/kinect360-remold-broker
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0022

[Install]
WantedBy=kinect360-remold.target
