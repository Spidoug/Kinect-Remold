[Unit]
StartLimitIntervalSec=30
StartLimitBurst=5
Description=Kinect Xbox 360 Remold authenticated IP camera
PartOf=kinect360-remold.target
After=kinect360-remold-camera.service network-online.target
Wants=network-online.target
Requires=kinect360-remold-camera.service

[Service]
Type=simple
User=kinect360-remold-ip
Group=kinect360-remold-ip
SupplementaryGroups=video
ExecStart=/usr/libexec/kinect360-remold/kinect360-remold-camera-ip
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=kinect360-remold.target
