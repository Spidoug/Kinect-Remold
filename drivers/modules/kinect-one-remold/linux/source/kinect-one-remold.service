[Unit]
Description=Kinect One Remold runtime
After=local-fs.target systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/libexec/kinect-one-remold/kinect-one-remold
Restart=on-failure
RestartSec=1s
RuntimeDirectory=kinect-one-remold
RuntimeDirectoryMode=0755
KillMode=control-group
TimeoutStopSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
