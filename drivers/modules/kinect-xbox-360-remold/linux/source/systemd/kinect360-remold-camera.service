[Unit]
StartLimitIntervalSec=30
StartLimitBurst=5
Description=Kinect Remold - Xbox 360 RGB/IR/depth bridge
PartOf=kinect360-remold.target
After=systemd-udevd.service kinect360-remold-broker.service kinect360-remold-audio.service
Wants=kinect360-remold-broker.service kinect360-remold-audio.service

[Service]
WorkingDirectory=/var/lib/kinect360-remold
Type=simple
ExecStart=/usr/libexec/kinect360-remold/kinect360-remold-camera
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0022

[Install]
WantedBy=kinect360-remold.target
