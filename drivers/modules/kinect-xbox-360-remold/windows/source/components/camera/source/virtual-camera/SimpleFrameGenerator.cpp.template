constexpr LONG kTiltMinimum = __REMOLD_TILT_MIN__;
constexpr LONG kTiltMaximum = __REMOLD_TILT_MAX__;
constexpr DWORD kFacePeriodMs = __REMOLD_FACE_PERIOD_MS__;
constexpr DWORD kTiltCommandWaitMs = 50;

LONG AbsLong(LONG value) noexcept { return value < 0 ? -value : value; }

// Product Smart Tilt policy (Product.psd1 SmartTiltPolicy). The control law
// itself and digital framing are shared with the Linux V4L2 camera.
SmartTilt::Policy SmartTiltPolicy() noexcept
{
    SmartTilt::Policy policy;
    policy.tiltMinDegrees = __REMOLD_TILT_MIN__;
    policy.tiltMaxDegrees = __REMOLD_TILT_MAX__;
    policy.startupTiltDegrees = __REMOLD_STARTUP_TILT__;
    policy.faceVerticalDeadZonePixels = __REMOLD_FACE_VERTICAL_DEAD_ZONE_PIXELS__;
    policy.faceErrorFilterAlpha = __REMOLD_FACE_ERROR_FILTER_ALPHA__;
    policy.accelFilterAlpha = __REMOLD_ACCEL_FILTER_ALPHA__;
    policy.accelCorrectionFilterAlpha = __REMOLD_ACCEL_CORRECTION_FILTER_ALPHA__;
    policy.minCommandDeltaDegrees = __REMOLD_MIN_COMMAND_DELTA_DEGREES__;
    policy.motorSettleToleranceDegrees = __REMOLD_MOTOR_SETTLE_TOLERANCE_DEGREES__;
    policy.motorSettleMs = __REMOLD_MOTOR_SETTLE_MS__;
    policy.commandPeriodMs = __REMOLD_TILT_COMMAND_PERIOD_MS__;
    return policy;
}

SmartTilt::Motion ToSmartTiltMotion(const ScannerPort::MotionSample& sample) noexcept
{
    SmartTilt::Motion motion;
    motion.accelValid = (sample.flags & ScannerPort::MotionAccelerometerValid) != 0;
    motion.tiltValid = (sample.flags & ScannerPort::MotionTiltValid) != 0;
    motion.accelX = sample.accelX;
    motion.accelY = sample.accelY;
    motion.accelZ = sample.accelZ;
    motion.tiltTenths = sample.tiltTenths;
    motion.tickMs = sample.tickMs;
    return motion;
}

HRESULT PipeExchange(const Control::Request& request, Control::Reply& reply, DWORD waitMs = 80)
{
    if (!WaitNamedPipeW(Control::kPipeName, waitMs)) return HRESULT_FROM_WIN32(GetLastError());
    HANDLE pipe = CreateFileW(Control::kPipeName, GENERIC_READ | GENERIC_WRITE, 0, nullptr,
                              OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (pipe == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
    DWORD mode = PIPE_READMODE_MESSAGE;
    (void)SetNamedPipeHandleState(pipe, &mode, nullptr, nullptr);
    DWORD done = 0;
    HRESULT hr = S_OK;
    if (!WriteFile(pipe, &request, sizeof(request), &done, nullptr) || done != sizeof(request)) {
        hr = HRESULT_FROM_WIN32(GetLastError());
    } else if (!ReadFile(pipe, &reply, sizeof(reply), &done, nullptr) || done != sizeof(reply)) {
        hr = HRESULT_FROM_WIN32(GetLastError());
    } else if (reply.magic != Control::kMagic || reply.version != Control::kVersion) {
        hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
    } else {
        hr = static_cast<HRESULT>(reply.result);
    }
    CloseHandle(pipe);
    return hr;
}

HRESULT SendControl(const std::wstring& deviceId, Control::Command command, LONG value, Control::Reply* output = nullptr, DWORD waitMs = 80)
{
    Control::Request request{};
    request.command = command;
    request.value = value;
    const size_t copy = (std::min)(deviceId.size(), static_cast<size_t>(Control::kDeviceIdBytes - 1));
    for (size_t i = 0; i < copy; ++i) {
        const wchar_t c = deviceId[i];
        if (c > 0x7f) return E_INVALIDARG;
        request.deviceId[i] = static_cast<char>(c);
    }
    request.deviceId[copy] = '\0';
    Control::Reply reply{};
    HRESULT hr = PipeExchange(request, reply, waitMs);
    if (output) *output = reply;
    return hr;
}

bool CopyLatestNv12FromMapping(HANDLE mapping, void* base, std::vector<BYTE>& destination,
                               uint32_t& sourceWidth, uint32_t& sourceHeight, uint64_t& sourceFrame,
                               ScannerPort::MotionSample& motion)
{
    if (!mapping || !base) return false;
    auto* h = static_cast<SharedHeader*>(base);
    if (h->magic != kMagic || h->version != kVersion || h->fourcc != kNv12Fourcc) return false;
    for (int attempt = 0; attempt < 4; ++attempt) {
        const LONG seq1 = h->colorSequence;
        MemoryBarrier();
        if (seq1 & 1) { SwitchToThread(); continue; }
        if (!h->online) return false;
        const LONG slot = h->activeSlot;
        if (slot < 0 || slot >= static_cast<LONG>(kSlotCount)) return false;
        const FrameSlotMeta meta = h->slot[slot];
        const uint32_t width = h->width;
        const uint32_t height = h->height;
        const uint32_t bytes = h->frameBytes;
        if ((width != kWidth && width != kHqWidth) ||
            (height != kHeight && height != kHqHeight) ||
            bytes != width * height * 3u / 2u || bytes > kHqNv12Bytes ||
            meta.bytes != bytes || meta.tickMs == 0 || GetTickCount64() - meta.tickMs > 2000) return false;
        if (destination.size() < bytes) destination.resize(bytes);
        std::memcpy(destination.data(), SlotAddress(base, static_cast<uint32_t>(slot)), bytes);
        MemoryBarrier();
        const LONG seq2 = h->colorSequence;
        if (seq1 == seq2 && !(seq2 & 1)) {
            sourceWidth = width;
            sourceHeight = height;
            sourceFrame = meta.frameNumber;
            motion = meta.motion;
            return true;
        }
    }
    return false;
}

void ResizeNv12(const BYTE* source, uint32_t sourceWidth, uint32_t sourceHeight,
                BYTE* target, uint32_t targetWidth, uint32_t targetHeight)
{
    if (!source || !target || !sourceWidth || !sourceHeight || !targetWidth || !targetHeight) return;
    const BYTE* sourceY = source;
    const BYTE* sourceUv = source + static_cast<size_t>(sourceWidth) * sourceHeight;
    BYTE* targetY = target;
    BYTE* targetUv = target + static_cast<size_t>(targetWidth) * targetHeight;
    for (uint32_t y = 0; y < targetHeight; ++y) {
        const uint32_t sy = (std::min)(sourceHeight - 1u, static_cast<uint32_t>((static_cast<uint64_t>(y) * sourceHeight) / targetHeight));
        for (uint32_t x = 0; x < targetWidth; ++x) {
            const uint32_t sx = (std::min)(sourceWidth - 1u, static_cast<uint32_t>((static_cast<uint64_t>(x) * sourceWidth) / targetWidth));
            targetY[static_cast<size_t>(y) * targetWidth + x] = sourceY[static_cast<size_t>(sy) * sourceWidth + sx];
        }
    }
    for (uint32_t y = 0; y < targetHeight / 2u; ++y) {
        const uint32_t sy = (std::min)(sourceHeight / 2u - 1u, static_cast<uint32_t>((static_cast<uint64_t>(y) * (sourceHeight / 2u)) / (targetHeight / 2u)));
        for (uint32_t x = 0; x < targetWidth; x += 2u) {
            uint32_t sx = (std::min)(sourceWidth - 2u, static_cast<uint32_t>((static_cast<uint64_t>(x) * sourceWidth) / targetWidth));
            sx &= ~1u;
            const size_t sp = static_cast<size_t>(sy) * sourceWidth + sx;
            const size_t tp = static_cast<size_t>(y) * targetWidth + x;
            targetUv[tp] = sourceUv[sp];
            targetUv[tp + 1u] = sourceUv[sp + 1u];
        }
    }
}

struct FaceTarget {
    bool valid = false;
    LONG count = 0;
    LONG x = 320;
    LONG y = 240;
    LONG width = 0;
    LONG height = 0;
};
