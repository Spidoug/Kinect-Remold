SimpleFrameGenerator::~SimpleFrameGenerator()
{
    StopSmartEngine();
    CloseMapping();
}

HRESULT SimpleFrameGenerator::Initialize(_In_ IMFMediaType* pMediaType, const std::wstring& deviceId)
{
    RETURN_HR_IF_NULL(E_INVALIDARG, pMediaType);
    RETURN_HR_IF(E_INVALIDARG, deviceId.empty());
    m_deviceId = deviceId;
    RETURN_IF_FAILED(pMediaType->GetGUID(MF_MT_SUBTYPE, &m_subType));
    if (m_subType != MFVideoFormat_NV12 && m_subType != MFVideoFormat_YUY2 &&
        m_subType != MFVideoFormat_RGB32)
        return MF_E_UNSUPPORTED_FORMAT;
    RETURN_IF_FAILED(MFGetAttributeSize(pMediaType, MF_MT_FRAME_SIZE, &m_width, &m_height));
    const bool vga = m_width == kWidth && m_height == kHeight;
    const bool hq = m_width == kHqWidth && m_height == kHqHeight;
    if (!vga && !hq) return MF_E_UNSUPPORTED_FORMAT;
    try {
        m_sourceNv12.resize(kHqNv12Bytes);
        m_latestNv12.resize(static_cast<size_t>(m_width) * m_height * 3u / 2u);
        m_framedNv12.resize(m_latestNv12.size());
    } catch (...) {
        return E_OUTOFMEMORY;
    }
    StartSmartEngine();
    return S_OK;
}

HRESULT SimpleFrameGenerator::EnsureMapping()
{
    if (m_mapping && m_base) return S_OK;
    CloseMapping();
    m_mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, MappingName(m_deviceId).c_str());
    if (!m_mapping) return HRESULT_FROM_WIN32(GetLastError());
    m_base = MapViewOfFile(m_mapping, FILE_MAP_READ, 0, 0, kMappingBytes);
    if (!m_base) {
        HRESULT hr = HRESULT_FROM_WIN32(GetLastError());
        CloseMapping();
        return hr;
    }
    const auto* h = static_cast<const SharedHeader*>(m_base);
    if (h->magic != kMagic || h->version != kVersion || h->fourcc != kNv12Fourcc ||
        h->slotCount != kSlotCount) {
        CloseMapping();
        return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
    }
    return S_OK;
}

bool SimpleFrameGenerator::ReadLatestNv12()
{
    if (FAILED(EnsureMapping())) return false;
    uint32_t sourceWidth = 0, sourceHeight = 0;
    uint64_t sourceFrame = 0;
    ScannerPort::MotionSample motion{};
    if (!CopyLatestNv12FromMapping(m_mapping, m_base, m_sourceNv12, sourceWidth, sourceHeight, sourceFrame, motion)) return false;
    if (m_latestNv12.size() != static_cast<size_t>(m_width) * m_height * 3u / 2u) return false;
    if (sourceWidth == m_width && sourceHeight == m_height) {
        std::memcpy(m_latestNv12.data(), m_sourceNv12.data(), m_latestNv12.size());
    } else {
        ResizeNv12(m_sourceNv12.data(), sourceWidth, sourceHeight,
                   m_latestNv12.data(), m_width, m_height);
    }
    m_sourceFrameNumber = sourceFrame;
    return true;
}

void SimpleFrameGenerator::ApplyDigitalFraming()
{
    if (m_framedNv12.size() != m_latestNv12.size() || m_latestNv12.empty()) return;
    auto& state = CameraControls::Global();
    SmartTilt::Framing framing;
    framing.panDegrees = state.panDegrees.load();
    framing.zoomPermille = state.zoomPermille.load();
    framing.verticalCropPermille = state.verticalCropPermille.load();
    const SmartTilt::CropRect crop = SmartTilt::FramingCrop(framing, m_width, m_height);
    if (crop.width == m_width && crop.height == m_height) {
        std::memcpy(m_framedNv12.data(), m_latestNv12.data(), m_latestNv12.size());
        return;
    }
    const uint32_t cropX = crop.x;
    const uint32_t cropY = crop.y;
    const uint32_t cropW = crop.width;
    const uint32_t cropH = crop.height;

    const BYTE* sourceY = m_latestNv12.data();
    const BYTE* sourceUv = sourceY + m_width * m_height;
    BYTE* targetY = m_framedNv12.data();
    BYTE* targetUv = targetY + m_width * m_height;

    for (uint32_t y = 0; y < m_height; ++y) {
        const uint32_t sy = cropY + (y * cropH) / m_height;
        const BYTE* row = sourceY + static_cast<size_t>(sy) * m_width;
        BYTE* out = targetY + static_cast<size_t>(y) * m_width;
        for (uint32_t x = 0; x < m_width; ++x) {
            const uint32_t sx = cropX + (x * cropW) / m_width;
            out[x] = row[sx];
        }
    }

    for (uint32_t y = 0; y < m_height / 2; ++y) {
        const uint32_t sy = cropY / 2u + (y * (cropH / 2u)) / (m_height / 2u);
        const BYTE* row = sourceUv + static_cast<size_t>(sy) * m_width;
        BYTE* out = targetUv + static_cast<size_t>(y) * m_width;
        for (uint32_t x = 0; x < m_width; x += 2) {
            uint32_t sx = cropX + (x * cropW) / m_width;
            sx &= ~1u;
            if (sx + 1 >= m_width) sx = m_width - 2;
            out[x] = row[sx];
            out[x + 1] = row[sx + 1];
        }
    }
}

HRESULT SimpleFrameGenerator::WriteNv12(BYTE* pBuf, DWORD len, LONG pitch) const
{
    if (pitch < static_cast<LONG>(m_width)) return E_INVALIDARG;
    const uint64_t required = static_cast<uint64_t>(pitch) * m_height * 3ull / 2ull;
    if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
    const BYTE* srcY = m_framedNv12.data();
    for (uint32_t y = 0; y < m_height; ++y)
        std::memcpy(pBuf + static_cast<size_t>(y) * pitch, srcY + static_cast<size_t>(y) * m_width, m_width);
    const BYTE* srcUv = srcY + m_width * m_height;
    BYTE* dstUv = pBuf + static_cast<size_t>(pitch) * m_height;
    for (uint32_t y = 0; y < m_height / 2; ++y)
        std::memcpy(dstUv + static_cast<size_t>(y) * pitch, srcUv + static_cast<size_t>(y) * m_width, m_width);
    return S_OK;
}

HRESULT SimpleFrameGenerator::WriteYuy2(BYTE* pBuf, DWORD len, LONG pitch) const
{
    const LONG kYuy2RowBytes = static_cast<LONG>(m_width * 2u);
    if (pitch < kYuy2RowBytes) return E_INVALIDARG;
    const uint64_t required = static_cast<uint64_t>(pitch) * m_height;
    if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
    const BYTE* yPlane = m_framedNv12.data();
    const BYTE* uvPlane = yPlane + m_width * m_height;
    for (uint32_t y = 0; y < m_height; ++y) {
        const BYTE* srcY = yPlane + static_cast<size_t>(y) * m_width;
        const BYTE* srcUv = uvPlane + static_cast<size_t>(y / 2u) * m_width;
        BYTE* dst = pBuf + static_cast<size_t>(y) * pitch;
        for (uint32_t x = 0; x < m_width; x += 2) {
            dst[2u * x + 0] = srcY[x + 0];
            dst[2u * x + 1] = srcUv[x + 0];
            dst[2u * x + 2] = srcY[x + 1];
            dst[2u * x + 3] = srcUv[x + 1];
        }
    }
    return S_OK;
}

HRESULT SimpleFrameGenerator::WriteRgb32(BYTE* pBuf, DWORD len, LONG pitch) const
{
    const LONG kRgbRowBytes = static_cast<LONG>(m_width * 4u);
    if (pitch < kRgbRowBytes) return E_INVALIDARG;
    const uint64_t required = static_cast<uint64_t>(pitch) * m_height;
    if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
    const BYTE* yPlane = m_framedNv12.data();
    const BYTE* uvPlane = yPlane + m_width * m_height;
    auto clamp8 = [](int value) -> BYTE {
        if (value < 0) return 0;
        if (value > 255) return 255;
        return static_cast<BYTE>(value);
    };
    for (uint32_t y = 0; y < m_height; ++y) {
        const BYTE* srcY = yPlane + static_cast<size_t>(y) * m_width;
        const BYTE* srcUv = uvPlane + static_cast<size_t>(y / 2u) * m_width;
        BYTE* dst = pBuf + static_cast<size_t>(y) * pitch;
        for (uint32_t x = 0; x < m_width; ++x) {
            const int ySample = static_cast<int>(srcY[x]) - 16;
            const int c = (ySample > 0) ? ySample : 0;
            const uint32_t uvx = x & ~1u;
            const int d = static_cast<int>(srcUv[uvx]) - 128;
            const int e = static_cast<int>(srcUv[uvx + 1]) - 128;
            dst[4u * x + 0] = clamp8((298 * c + 516 * d + 128) >> 8);
            dst[4u * x + 1] = clamp8((298 * c - 100 * d - 208 * e + 128) >> 8);
            dst[4u * x + 2] = clamp8((298 * c + 409 * e + 128) >> 8);
            dst[4u * x + 3] = 0;
        }
    }
    return S_OK;
}

HRESULT SimpleFrameGenerator::WriteBlackFrame(BYTE* pBuf, DWORD len, LONG pitch) const
{
    if (m_subType == MFVideoFormat_NV12) {
        if (pitch < static_cast<LONG>(m_width)) return E_INVALIDARG;
        const uint64_t required = static_cast<uint64_t>(pitch) * m_height * 3ull / 2ull;
        if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
        for (uint32_t y = 0; y < m_height; ++y) std::memset(pBuf + static_cast<size_t>(y) * pitch, 16, m_width);
        BYTE* uv = pBuf + static_cast<size_t>(pitch) * m_height;
        for (uint32_t y = 0; y < m_height / 2; ++y) std::memset(uv + static_cast<size_t>(y) * pitch, 128, m_width);
        return S_OK;
    }
    if (m_subType == MFVideoFormat_YUY2) {
        const LONG rowBytes = static_cast<LONG>(m_width * 2u);
        if (pitch < rowBytes || static_cast<uint64_t>(pitch) * m_height > len) return E_INVALIDARG;
        for (uint32_t y = 0; y < m_height; ++y) {
            BYTE* dst = pBuf + static_cast<size_t>(y) * pitch;
            for (uint32_t x = 0; x < m_width; x += 2) { dst[2*x]=16; dst[2*x+1]=128; dst[2*x+2]=16; dst[2*x+3]=128; }
        }
        return S_OK;
    }
    if (m_subType == MFVideoFormat_RGB32) {
        const LONG rowBytes = static_cast<LONG>(m_width * 4u);
        if (pitch < rowBytes || static_cast<uint64_t>(pitch) * m_height > len) return E_INVALIDARG;
        for (uint32_t y = 0; y < m_height; ++y) std::memset(pBuf + static_cast<size_t>(y) * pitch, 0, m_width * 4u);
        return S_OK;
    }
    return MF_E_UNSUPPORTED_FORMAT;
}

HRESULT SimpleFrameGenerator::CreateFrame(BYTE* pBuf, DWORD len, LONG pitch, ULONG)
{
    std::lock_guard<std::mutex> guard(m_lock);
    RETURN_HR_IF_NULL(E_INVALIDARG, pBuf);

    // A frame request is the authoritative local signal that the virtual
    // camera is actively consumed. It drives Smart Tilt and renews the frame
    // consumer lease that makes CameraBridge sample the motion status.
    const ULONGLONG now = GetTickCount64();
    m_lastRgbActivity.store(now, std::memory_order_relaxed);
    m_consumerLease.Renew(m_deviceId);
    if (!ReadLatestNv12()) return WriteBlackFrame(pBuf, len, pitch);
    ApplyDigitalFraming();
    if (m_subType == MFVideoFormat_NV12) return WriteNv12(pBuf, len, pitch);
    if (m_subType == MFVideoFormat_YUY2) return WriteYuy2(pBuf, len, pitch);
    if (m_subType == MFVideoFormat_RGB32) return WriteRgb32(pBuf, len, pitch);
    return MF_E_UNSUPPORTED_FORMAT;
}

void SimpleFrameGenerator::StartSmartEngine()
{
    bool expected = false;
    if (!m_engineRun.compare_exchange_strong(expected, true)) return;
    try {
        m_engineThread = std::thread(&SimpleFrameGenerator::SmartEngineLoop, this);
    } catch (...) {
        m_engineRun.store(false);
    }
}

void SimpleFrameGenerator::StopSmartEngine()
{
    if (!m_engineRun.exchange(false)) return;
    if (m_engineThread.joinable()) m_engineThread.join();
    CameraControls::Global().engineOnline.store(0);
}

void SimpleFrameGenerator::SmartEngineLoop()
{
    auto& state = CameraControls::Global();
    try { winrt::init_apartment(winrt::apartment_type::multi_threaded); }
    catch (const winrt::hresult_error& e) {
        state.lastControlHresult.store(e.code());
        return;
    }

    using namespace winrt::Windows::Graphics::Imaging;
    using namespace winrt::Windows::Media;
    using namespace winrt::Windows::Media::FaceAnalysis;
    using namespace winrt::Windows::Storage::Streams;

    winrt::Windows::Media::FaceAnalysis::FaceTracker tracker{nullptr};
    bool faceTrackerReady = false;
    try {
        if (FaceTracker::IsSupported() && FaceTracker::IsBitmapPixelFormatSupported(BitmapPixelFormat::Nv12)) {
            tracker = FaceTracker::CreateAsync().get();
            faceTrackerReady = true;
        } else {
            // Manual/continuous Tilt and hardware status remain available even when
            // Windows does not provide FaceTracker support.
            state.lastControlHresult.store(HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED));
        }
    } catch (const winrt::hresult_error& e) {
        state.lastControlHresult.store(e.code());
    }

    HANDLE mapping = nullptr;
    void* mappingBase = nullptr;
    std::vector<BYTE> frame;
    try { frame.resize(m_latestNv12.size()); }
    catch (...) { state.lastControlHresult.store(E_OUTOFMEMORY); return; }

    // Motion comes only from the per-frame sample published by CameraBridge,
    // the single status owner; this engine never polls the broker.
    SmartTilt::Controller controller(SmartTiltPolicy());
    bool wasActive = false;
    state.stabilizationCorrectionTenths.store(0);
    state.engineOnline.store(0);

    while (m_engineRun.load()) {
        const ULONGLONG now = GetTickCount64();
        const ULONGLONG activityTick = m_lastRgbActivity.load(std::memory_order_relaxed);
        const bool virtualCameraActive = activityTick != 0 && now - activityTick <= kConsumerLeaseMs;
        if (!virtualCameraActive) {
            // Tilt, stabilization and FaceTracker are exclusively a virtual-camera
            // feature. Keeping the media source alive never moves the motor.
            if (wasActive) controller.Reset(now);
            wasActive = false;
            state.engineOnline.store(0);
            state.stabilizationCorrectionTenths.store(0);
            for (DWORD slept=0; slept<kFacePeriodMs && m_engineRun.load(); slept+=10) Sleep(10);
            continue;
        }
        if (!wasActive) {
            // Activation resets the controller and the automatic framing; the
            // manual pan/zoom of a client is kept while automatic framing is off.
            controller.Reset(now);
            if (state.autoFraming.load() != 0) {
                state.panDegrees.store(0);
                state.zoomPermille.store(SmartTilt::kZoomMinPermille);
                state.verticalCropPermille.store(0);
            }
            wasActive = true;
        }
        state.engineOnline.store(1);
        if (!mapping) {
            mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, MappingName(m_deviceId).c_str());
            if (mapping) mappingBase = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, kMappingBytes);
            if (!mappingBase && mapping) { CloseHandle(mapping); mapping = nullptr; }
        }

        bool gotFrame = false;
        ScannerPort::MotionSample frameMotion{};
        if (mapping && mappingBase) {
            uint32_t sourceWidth = 0, sourceHeight = 0;
            uint64_t sourceFrame = 0;
            std::vector<BYTE> raw;
            try { raw.resize(kHqNv12Bytes); } catch (...) { raw.clear(); }
            if (!raw.empty() && CopyLatestNv12FromMapping(mapping, mappingBase, raw, sourceWidth, sourceHeight, sourceFrame, frameMotion)) {
                if (frame.size() != m_latestNv12.size()) frame.resize(m_latestNv12.size());
                if (sourceWidth == m_width && sourceHeight == m_height) {
                    std::memcpy(frame.data(), raw.data(), frame.size());
                } else {
                    ResizeNv12(raw.data(), sourceWidth, sourceHeight, frame.data(), m_width, m_height);
                }
                gotFrame = true;
            }
        }
        const SmartTilt::Motion motion = ToSmartTiltMotion(frameMotion);
        state.motorTransport.store(motion.tiltValid ? static_cast<LONG>(Control::Transport::PhysicalMotor) : 0);
        if (motion.accelValid) {
            state.accelX.store(motion.accelX); state.accelY.store(motion.accelY); state.accelZ.store(motion.accelZ);
        }

        FaceTarget target{};
        // FaceTracker is control-only: it analyzes a private copy of the RGB frame.
        // No face rectangle, landmark, overlay, or face metadata is ever drawn into
        // the Windows Camera image; only the internal Tilt/framing target is updated.
        if (faceTrackerReady && gotFrame && state.faceTracking.load()) {
            try {
                if (m_latestNv12.size() > static_cast<size_t>((std::numeric_limits<uint32_t>::max)())) throw winrt::hresult_error(E_INVALIDARG);
                const uint32_t nv12Bytes = static_cast<uint32_t>(m_latestNv12.size());
                Buffer buffer(nv12Bytes);
                buffer.Length(nv12Bytes);
                BYTE* bytes = buffer.data();
                if (!bytes) throw winrt::hresult_error(E_POINTER);
                std::memcpy(bytes, frame.data(), m_latestNv12.size());
                SoftwareBitmap bitmap = SoftwareBitmap::CreateCopyFromBuffer(buffer, BitmapPixelFormat::Nv12, m_width, m_height);
                VideoFrame videoFrame = VideoFrame::CreateWithSoftwareBitmap(bitmap);
                auto faces = tracker.ProcessNextFrameAsync(videoFrame).get();
                target.count = static_cast<LONG>(faces.Size());
                if (target.count > 0) {
                    const LONG mode = state.targetMode.load();
                    uint32_t minX=m_width, minY=m_height, maxX=0, maxY=0;
                    uint64_t bestMetric = 0;
                    BitmapBounds best{};
                    for (auto const& face : faces) {
                        BitmapBounds box = face.FaceBox();
                        if (box.X < minX) minX=box.X; if (box.Y < minY) minY=box.Y;
                        if (box.X + box.Width > maxX) maxX=box.X+box.Width;
                        if (box.Y + box.Height > maxY) maxY=box.Y+box.Height;
                        uint64_t metric = static_cast<uint64_t>(box.Width) * box.Height;
                        if (mode == static_cast<LONG>(CameraControls::TargetMode::CenterFace)) {
                            LONG cx=static_cast<LONG>(box.X + box.Width/2); LONG cy=static_cast<LONG>(box.Y + box.Height/2);
                            LONG dx=AbsLong(cx-static_cast<LONG>(m_width/2)); LONG dy=AbsLong(cy-static_cast<LONG>(m_height/2));
                            metric = static_cast<uint64_t>(1000000 - ((dx+dy) > 999999 ? 999999 : (dx+dy)));
                        }
                        if (metric > bestMetric) { bestMetric=metric; best=box; }
                    }
                    if (mode == static_cast<LONG>(CameraControls::TargetMode::Group) && target.count > 1) {
                        target.x=static_cast<LONG>((minX+maxX)/2); target.y=static_cast<LONG>((minY+maxY)/2);
                        target.width=static_cast<LONG>(maxX-minX); target.height=static_cast<LONG>(maxY-minY);
                    } else {
                        target.x=static_cast<LONG>(best.X+best.Width/2); target.y=static_cast<LONG>(best.Y+best.Height/2);
                        target.width=static_cast<LONG>(best.Width); target.height=static_cast<LONG>(best.Height);
                    }
                    target.valid=true;
                }
            } catch (const winrt::hresult_error& e) {
                state.lastControlHresult.store(e.code());
            }
        }

        state.faceCount.store(target.count);
        if (target.valid) {
            state.faceCenterX.store(target.x); state.faceCenterY.store(target.y);
            state.faceWidth.store(target.width); state.faceHeight.store(target.height);
        } else {
            state.faceWidth.store(0); state.faceHeight.store(0);
        }

        SmartTilt::Settings settings;
        settings.autoFraming = state.autoFraming.load() != 0;
        settings.trackingSpeed = CameraControls::ClampLong(state.trackingSpeed.load(), 1, 100);
        settings.stabilization = state.tiltStabilization.load() != 0;
        settings.stabilizationStrength = CameraControls::ClampLong(state.stabilizationStrength.load(), 1, 100);
        settings.autoCenter = state.autoCenter.load() != 0;
        settings.manualTiltDegrees = CameraControls::ClampLong(state.tiltDegrees.load(), kTiltMinimum, kTiltMaximum);
        SmartTilt::Face face;
        face.valid = target.valid;
        face.centerY = target.y;
        face.frameHeight = static_cast<int>(m_height);
        const SmartTilt::Step step = controller.Update(now, motion, face, settings);
        state.stabilizationCorrectionTenths.store(step.stabilizationCorrectionTenths);
        // Automatic framing reports the measured physical angle; manual mode
        // keeps the user's requested angle in the standard Tilt control.
        if (settings.autoFraming && step.measuredTiltValid) state.tiltDegrees.store(step.measuredTiltDegrees);

        if (settings.autoFraming) {
            SmartTilt::Framing framing;
            framing.panDegrees = state.panDegrees.load();
            framing.zoomPermille = state.zoomPermille.load();
            framing.verticalCropPermille = state.verticalCropPermille.load();
            SmartTilt::FaceBox box;
            box.valid = target.valid;
            box.centerX = target.x;
            box.centerY = target.y;
            box.width = target.width;
            box.height = target.height;
            SmartTilt::FramingSettings framingSettings;
            framingSettings.deadZonePercent = state.deadZonePercent.load();
            framingSettings.digitalZoomLimitPercent = state.digitalZoomLimitPercent.load();
            framing = SmartTilt::UpdateFraming(framing, box, static_cast<int>(m_width), static_cast<int>(m_height),
                                               step, settings.trackingSpeed, framingSettings);
            state.panDegrees.store(framing.panDegrees);
            state.zoomPermille.store(framing.zoomPermille);
            state.verticalCropPermille.store(framing.verticalCropPermille);
        }

        if (step.command) {
            const HRESULT hr = SendControl(m_deviceId, Control::Command::Tilt, step.commandDegrees, nullptr, kTiltCommandWaitMs);
            state.lastControlHresult.store(hr);
            if (SUCCEEDED(hr)) controller.CommandAccepted(step.commandDegrees, now);
        }

        for (DWORD slept=0; slept<kFacePeriodMs && m_engineRun.load(); slept+=10) Sleep(10);
    }

    if (mappingBase) UnmapViewOfFile(mappingBase);
    if (mapping) CloseHandle(mapping);
    state.engineOnline.store(0);
    winrt::uninit_apartment();
}

void SimpleFrameGenerator::CloseMapping()
{
    if (m_base) UnmapViewOfFile(m_base);
    if (m_mapping) CloseHandle(m_mapping);
    m_base = nullptr;
    m_mapping = nullptr;
}
