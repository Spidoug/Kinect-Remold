# Native driver outputs are generated from source.
drivers/windows/binaries/
drivers/windows/source/logs/
drivers/windows/source/components/*/dist/
drivers/windows/source/source/setup/x64/
drivers/windows/source/source/setup/Release/
drivers/linux/packages/output/

# Native compilation intermediates.
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.sys
*.cat
*.pdb
*.deb
*.rpm

# Java/Processing transient outputs.
applications/binaries/
*.class
applications/processing/SynKinectStudio/build/

# Logs and temporary files.
logs/
*.log
*.tmp
*.bak
*~

# Repository-local dependency/build cache.
.cache/

# Python cache files.
**/__pycache__/
*.pyc

# Linux firmware/download cache is local build state.
drivers/linux/cache/
drivers/linux/source/cache/
